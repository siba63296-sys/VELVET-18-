# Velvet 18+ AI Platform - Environment Variables Template
# Copy this file to .env or .env.local and populate with your credentials.

# 1. Supabase Postgres & Auth
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. Cashfree Payment Gateway (India - UPI, Cards, NetBanking)
CASHFREE_APP_ID="CF_APP_ID_TEST_OR_PROD"
CASHFREE_SECRET_KEY="CF_SECRET_KEY_TEST_OR_PROD"
CASHFREE_ENV="SANDBOX"
CASHFREE_WEBHOOK_SECRET="cf_whsec_..."
NEXT_PUBLIC_CASHFREE_ENV="SANDBOX"

# 3. Auth & Session Keys
AUTH_SECRET="your-32-byte-hex-secret-for-jwt-signing"
NEXTAUTH_URL="http://localhost:3000"

# 4. AI Inference Keys (Server-side Only)
SPICY_API_KEY="sk_spicy_live_your_api_key_here"
SPICY_BASE_URL="https://api.spicyai.cloud/v1/diffusion"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
